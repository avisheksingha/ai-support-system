# DATABASE
DB_USERNAME=postgres
DB_PASSWORD=your-database-password

# Google GenAI (Vertex AI / Google Cloud)
# The current application profiles use the Google Cloud project and location below.
# Install the gcloud CLI and authenticate with Application Default Credentials:
#   gcloud auth application-default login
# Alternatively, set GOOGLE_APPLICATION_CREDENTIALS outside this file to a service-account key path.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# OpenAI
OPENAI_API_KEY=sk-your-real-openai-key

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# JWT
# Generate at least 32 random bytes and encode them as Base64.
# The same secret must be supplied to auth-service and api-gateway.
JWT_SECRET=replace-with-a-strong-base64-encoded-secret

# INITIAL ADMIN CONFIGURATION
ADMIN_EMAIL=your-admin-email@domain.com
ADMIN_PASSWORD=your-secure-admin-password
